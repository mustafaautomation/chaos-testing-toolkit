{
  "name": "chaos-testing-toolkit",
  "version": "1.0.0",
  "description": "Application-layer chaos testing — inject API timeouts, DB failures, service errors. YAML scenarios with Playwright integration.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "chaos": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.ts\"",
    "format:check": "prettier --check \"**/*.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "author": "Quvantic <info@quvantic.com> (https://quvantic.com)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mustafaautomation/chaos-testing-toolkit.git"
  },
  "homepage": "https://github.com/mustafaautomation/chaos-testing-toolkit#readme",
  "dependencies": {
    "commander": "^12.1.0",
    "express": "^4.21.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ]
}
